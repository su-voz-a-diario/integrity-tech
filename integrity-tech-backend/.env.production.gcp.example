# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE PRODUCCIÓN - GOOGLE CLOUD PLATFORM (GCP)
# -----------------------------------------------------------------------------
# Este archivo sirve como plantilla para las variables de entorno necesarias
# en el backend de Integrity Tech al desplegarse en GCP (Cloud Run, Cloud SQL,
# Memorystore Redis y Cloud Storage).
#
# NOTA: En Cloud Run, los secretos sensibles deben inyectarse directamente
# desde Secret Manager como variables de entorno o volúmenes montados.
# -----------------------------------------------------------------------------

# Entorno general
NODE_ENV=production
PORT=3001

# 1. Base de datos - Cloud SQL PostgreSQL
# Formato para conexión directa TCP (a través de IP privada o proxy de Cloud SQL en puerto local):
# DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/<DB_NAME>?schema=public&connection_limit=10"
# NOTA: Si se usa Cloud SQL Auth Proxy en Cloud Run, se conecta a través de 127.0.0.1:5432
DATABASE_URL=postgresql://postgres:change-me-strong-password@127.0.0.1:5432/integrity_db?schema=public&connection_limit=10

# 2. Seguridad y Sesiones (Almacenado en Secret Manager)
# Debe ser una cadena aleatoria de al menos 32 caracteres generada de forma segura
JWT_SECRET=replace-with-a-secure-32-character-random-key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://integrity-tech-eight.vercel.app

# 3. Redis - Memorystore Redis
# En GCP Memorystore, la IP de la instancia Redis se conecta a través de un conector VPC sin servidor.
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
# En Memorystore de GCP, por defecto no requiere contraseña, pero si está habilitada AUTH, configúrala aquí:
REDIS_PASSWORD=

# URL Completa de Redis para Rate Limiter (si aplica, derivado del Host/Port/Password)
# REDIS_URL=redis://10.0.0.3:6379
REDIS_URL=redis://10.0.0.3:6379

# 4. Almacenamiento Privado - Google Cloud Storage (GCS)
STORAGE_PROVIDER=gcs
STORAGE_GCS_BUCKET=integrity-tech-private-storage
# Opcionales si se ejecutan fuera de GCP (en Cloud Run se usa el Rol IAM del Service Account asociado):
STORAGE_GCS_PROJECT_ID=google-cloud-project-id
# STORAGE_GCS_KEY_FILE=/app/keys/gcp-service-account.json

STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_FILE_BYTES=2097152

# 5. Seguridad y Rate Limiting
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_REQUIRED=true

# 6. Observabilidad y Monitoreo (OpenTelemetry & Cloud Trace)
OTEL_ENABLED=true
# En Cloud Run, puedes configurar el OpenTelemetry Collector como sidecar, apuntando a localhost:4318,
# o exportar directamente a la dirección de tu colector:
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LOG_LEVEL=info
SHOW_SWAGGER=false
ENABLE_DEV_AUTH=false
API_BODY_LIMIT=1mb
