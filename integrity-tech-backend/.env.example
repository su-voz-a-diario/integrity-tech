# =============================================================================
# Integrity Test Backend - Development
# Copy to .env for local development only.
# For staging/production use .env.staging.example / .env.production.example.
# =============================================================================
PORT=3001
DATABASE_URL=postgresql://postgres:localpassword123@localhost:5432/integrity_tech_db?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=integrity:dev:
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_REQUIRED=false
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
SHOW_SWAGGER=true
API_BODY_LIMIT=1mb
NODE_ENV=development
ENABLE_DEV_AUTH=true
DEMO_STAFF_EMAIL=admin@integrity.demo
DEMO_STAFF_PASSWORD=IntegrityDemo123!
LATE_ANSWER_WINDOW_MS=300000
OTEL_ENABLED=true
OTEL_SERVICE_NAME=integrity-tech-backend
# Optional. Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
STORAGE_PROVIDER=
STORAGE_LOCAL_PRIVATE_PATH=.private-storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_FILE_BYTES=2097152
BUILD_DATE=local
