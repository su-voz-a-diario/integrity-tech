datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// MÓDULO 1: IDENTIDAD, ORGANIZACIONES Y SEGURIDAD (Tenant & Auth Domain)
// ============================================================================

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users                User[]
  userSessions        UserSession[]
  candidateInvitations CandidateInvitation[]
  examAttempts        ExamAttempt[]
  perfilesPuesto      PerfilPuesto[]
  auditEvents          AuditEvent[]
  candidateConsents    CandidateConsent[]
  retentionPolicies    RetentionPolicy[]
  dataLifecycleRecords DataLifecycleRecord[]
  dataExportJobs       DataExportJob[]
  dataDeletionRequests DataDeletionRequest[]
  criticalAssetVersions CriticalAssetVersion[]
  backupRecoveryEvents BackupRecoveryEvent[]
  assessments          Assessment[]
  psychometricCategories PsychometricCategory[]
  competencies         Competency[]
  psychometricScales   PsychometricScale[]
  items                Item[]
  normGroups           NormGroup[]
  scoringModels        ScoringModel[]
  reportTemplates      ReportTemplate[]
  privateFiles         PrivateFile[]

  @@map("organizations")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  pais           String?  @db.VarChar(100)
  sector         String?  @db.VarChar(100)
  nivelEducativo String?  @map("nivel_educativo") @db.VarChar(100)
  tipoPuesto     String?  @map("tipo_puesto") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]
  userSessions   UserSession[]
  auditEvents    AuditEvent[]
  candidateConsents CandidateConsent[]
  privateFiles      PrivateFile[]

  @@unique([organizationId, email], name: "unique_email_per_org")
  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([refreshTokenHash])
  @@index([organizationId])
  @@map("user_sessions")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(50)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(50)
  action         String   @db.VarChar(120)
  resourceType   String   @map("resource_type") @db.VarChar(120)
  resourceId     String?  @map("resource_id") @db.VarChar(120)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

// ============================================================================
// MÓDULO 1B: GOBIERNO DE DATOS, RETENCIÓN Y TRAZABILIDAD LEGAL
// ============================================================================

model RetentionPolicy {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  dataType            String   @map("data_type") @db.VarChar(80)
  classification      String   @db.VarChar(50)
  activeDays          Int      @map("active_days")
  archiveAfterDays    Int      @map("archive_after_days")
  deleteAfterDays     Int      @map("delete_after_days")
  purgeAfterDays      Int      @map("purge_after_days")
  legalHoldAllowed    Boolean  @default(true) @map("legal_hold_allowed")
  description         String?  @db.Text
  isDefault           Boolean  @default(false) @map("is_default")
  createdByUserId     String?  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dataType])
  @@index([organizationId, classification])
  @@map("retention_policies")
}

model DataLifecycleRecord {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  resourceType        String    @map("resource_type") @db.VarChar(80)
  resourceId          String    @map("resource_id") @db.VarChar(120)
  classification      String    @db.VarChar(50)
  state               String    @default("ACTIVE") @db.VarChar(50)
  activeAt            DateTime  @default(now()) @map("active_at") @db.Timestamptz
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  purgedAt            DateTime? @map("purged_at") @db.Timestamptz
  legalHoldUntil      DateTime? @map("legal_hold_until") @db.Timestamptz
  lastReviewedAt      DateTime? @map("last_reviewed_at") @db.Timestamptz
  metadata            Json?     @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, resourceType, resourceId])
  @@index([organizationId, state, resourceType])
  @@index([organizationId, classification])
  @@map("data_lifecycle_records")
}

model DataExportJob {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  subjectType        String    @map("subject_type") @db.VarChar(80)
  subjectId          String    @map("subject_id") @db.VarChar(120)
  format             String    @default("JSON") @db.VarChar(20)
  status             String    @default("PENDING") @db.VarChar(50)
  reason             String    @db.Text
  manifest           Json?     @db.JsonB
  exportedPayload    Json?     @map("exported_payload") @db.JsonB
  errorMessage       String?   @map("error_message") @db.Text
  requestedAt        DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, status, requestedAt])
  @@map("data_export_jobs")
}

model DataDeletionRequest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  subjectType        String    @map("subject_type") @db.VarChar(80)
  subjectId          String    @map("subject_id") @db.VarChar(120)
  status             String    @default("PENDING") @db.VarChar(50)
  reason             String    @db.Text
  dryRun             Boolean   @default(true) @map("dry_run")
  approvedByUserId   String?   @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  executedAt         DateTime? @map("executed_at") @db.Timestamptz
  errorMessage       String?   @map("error_message") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        DataDeletionItem[]

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, status, createdAt])
  @@map("data_deletion_requests")
}

model DataDeletionItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId         String    @map("request_id") @db.Uuid
  resourceType      String    @map("resource_type") @db.VarChar(80)
  resourceId        String    @map("resource_id") @db.VarChar(120)
  plannedAction     String    @map("planned_action") @db.VarChar(50)
  status            String    @default("PENDING") @db.VarChar(50)
  executedAt        DateTime? @map("executed_at") @db.Timestamptz
  checksumBefore    String?   @map("checksum_before") @db.VarChar(128)
  metadata          Json?     @db.JsonB

  request DataDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, resourceType])
  @@map("data_deletion_items")
}

model CriticalAssetVersion {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  assetType          String    @map("asset_type") @db.VarChar(80)
  assetKey           String    @map("asset_key") @db.VarChar(120)
  version            String    @db.VarChar(50)
  status             String    @default("DRAFT") @db.VarChar(50)
  contentHash        String    @map("content_hash") @db.VarChar(128)
  payload            Json      @db.JsonB
  effectiveFrom      DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo        DateTime? @map("effective_to") @db.Timestamptz
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  approvedByUserId   String?   @map("approved_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, assetType, assetKey, version])
  @@index([organizationId, assetType, assetKey, status])
  @@map("critical_asset_versions")
}

model BackupRecoveryEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(80)
  scope          String   @db.VarChar(80)
  status         String   @db.VarChar(50)
  integrityHash  String?  @map("integrity_hash") @db.VarChar(128)
  storageRef     String?  @map("storage_ref") @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventType, status, createdAt])
  @@map("backup_recovery_events")
}

model PrivateFile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  attemptId       String?   @map("attempt_id") @db.Uuid
  resourceType    String    @map("resource_type") @db.VarChar(80)
  resourceId      String?   @map("resource_id") @db.VarChar(120)
  storageProvider String    @map("storage_provider") @db.VarChar(50)
  bucket          String?   @db.VarChar(255)
  objectKey       String    @map("object_key") @db.Text
  mimeType        String    @map("mime_type") @db.VarChar(120)
  sizeBytes       BigInt    @map("size_bytes")
  checksumSha256  String    @map("checksum_sha256") @db.VarChar(64)
  classification  String    @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerUser    User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  attempt      ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, attemptId])
  @@index([organizationId, ownerUserId])
  @@index([checksumSha256])
  @@map("private_files")
}

// ============================================================================
// MÓDULO 1C: GOBIERNO PSICOMÉTRICO Y TRAZABILIDAD CIENTÍFICA
// ============================================================================

model PsychometricCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        Item[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("psychometric_categories")
}

model Competency {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        Item[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("competencies")
}

model PsychometricScale {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscales    PsychometricSubscale[]
  items        Item[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("psychometric_scales")
}

model PsychometricSubscale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scaleId   String   @map("scale_id") @db.Uuid
  code      String   @db.VarChar(80)
  name      String   @db.VarChar(160)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  scale PsychometricScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([scaleId, code])
  @@index([scaleId, name])
  @@map("psychometric_subscales")
}

model Assessment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  status         String   @default("DRAFT") @db.VarChar(50)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     AssessmentVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("assessments")
}

model AssessmentVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String    @map("assessment_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  version        String    @db.VarChar(50)
  status         String    @default("DRAFT") @db.VarChar(50)
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  blueprintJson  Json      @map("blueprint_json") @db.JsonB
  contentHash    String    @map("content_hash") @db.VarChar(128)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  retiredAt      DateTime? @map("retired_at") @db.Timestamptz
  retirementReason String? @map("retirement_reason") @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  approvedByUserId String? @map("approved_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  itemLinks  AssessmentVersionItem[]
  attempts   ExamAttempt[]
  normGroups NormGroup[]
  scoringModels ScoringModel[]
  reportTemplates ReportTemplate[]

  @@unique([assessmentId, version])
  @@index([organizationId, status])
  @@index([organizationId, publishedAt])
  @@map("assessment_versions")
}

model Item {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  itemCode       String   @map("item_code") @db.VarChar(120)
  categoryId     String?  @map("category_id") @db.Uuid
  competencyId   String?  @map("competency_id") @db.Uuid
  scaleId        String?  @map("scale_id") @db.Uuid
  subscaleId     String?  @map("subscale_id") @db.Uuid
  status         String   @default("DRAFT") @db.VarChar(50)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     PsychometricCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  competency   Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  scale        PsychometricScale? @relation(fields: [scaleId], references: [id], onDelete: SetNull)
  subscale     PsychometricSubscale? @relation(fields: [subscaleId], references: [id], onDelete: SetNull)
  versions     ItemVersion[]

  @@unique([organizationId, itemCode])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, competencyId])
  @@map("items")
}

model ItemVersion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId              String    @map("item_id") @db.Uuid
  version             String    @db.VarChar(50)
  status              String    @default("DRAFT") @db.VarChar(50)
  language            String    @default("es") @db.VarChar(10)
  stemJson            Json      @map("stem_json") @db.JsonB
  scoringKeyJson      Json?     @map("scoring_key_json") @db.JsonB
  tags                Json?     @db.JsonB
  exposureRate        Decimal?  @map("exposure_rate") @db.Decimal(7, 4)
  difficulty          Float?
  discrimination      Float?
  expectedTimeSeconds Int?      @map("expected_time_seconds")
  contentHash         String    @map("content_hash") @db.VarChar(128)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz
  retiredAt           DateTime? @map("retired_at") @db.Timestamptz
  retirementReason    String?   @map("retirement_reason") @db.Text
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  approvedByUserId    String?   @map("approved_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  item       Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assessmentLinks AssessmentVersionItem[]
  submissions AnswerSubmission[]

  @@unique([itemId, version])
  @@index([status, language])
  @@map("item_versions")
}

model AssessmentVersionItem {
  assessmentVersionId String  @map("assessment_version_id") @db.Uuid
  itemVersionId       String  @map("item_version_id") @db.Uuid
  sortOrder           Int     @default(0) @map("sort_order")
  weight              Decimal @default(1.00) @db.Decimal(8, 4)
  role                String? @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  assessmentVersion AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  itemVersion       ItemVersion       @relation(fields: [itemVersionId], references: [id], onDelete: Restrict)

  @@id([assessmentVersionId, itemVersionId])
  @@index([assessmentVersionId, sortOrder])
  @@map("assessment_version_items")
}

model NormGroup {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  assessmentVersionId String   @map("assessment_version_id") @db.Uuid
  code                String   @db.VarChar(120)
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  populationJson      Json     @map("population_json") @db.JsonB
