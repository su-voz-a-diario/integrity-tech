  driftAlert          Boolean  @default(false) @map("drift_alert")
  marginalReliability Float    @default(0.80) @map("marginal_reliability")

  @@index([organizationId, testId, fecha])
  @@map("psychometric_quality_logs")
}

model CutScore {
  id        Int     @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  testId    String  @map("test_id") @db.VarChar(50)
  categoria String  @db.VarChar(100)
  thetaMin  Float   @map("theta_min")
  thetaMax  Float?  @map("theta_max")
  orden     Int

  @@index([organizationId, testId])
  @@map("cut_scores")
}

model ParametrosItemsHistorial {
  id               Int      @id @default(autoincrement())
  organizationId   String   @map("organization_id") @db.Uuid
  testId           String   @map("test_id") @db.VarChar(50)
  itemId           String   @map("item_id") @db.VarChar(50)
  modelo           String   @db.VarChar(10)
  parametroA       Float    @map("parametro_a")
  parametroB       Float?   @map("parametro_b")
  parametroC1      Float?   @map("parametro_c1")
  parametroC2      Float?   @map("parametro_c2")
  parametroC3      Float?   @map("parametro_c3")
  parametroC4      Float?   @map("parametro_c4")
  errorEstandar    Float?   @map("error_estandar")
  pValueAjuste     Float?   @map("p_value_ajuste")
  rmseaItem        Float?   @map("rmsea_item")
  flagDif          Boolean  @map("flag_dif")
  fechaCalibracion DateTime @map("fecha_calibracion") @db.Timestamptz
  fechaArchivado   DateTime @default(now()) @map("fecha_archivado") @db.Timestamptz

  @@index([organizationId, testId, fechaArchivado])
  @@map("parametros_items_historial")
}

model ContinuousNorm {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  testId             String   @map("test_id") @db.VarChar(50)
  pais               String?  @db.VarChar(100)
  nivelEducativo     String?  @map("nivel_educativo") @db.VarChar(100)
  tipoPuesto         String?  @map("tipo_puesto") @db.VarChar(100)
  p5                 Decimal  @db.Decimal(8, 4)
  p10                Decimal  @db.Decimal(8, 4)
  p25                Decimal  @db.Decimal(8, 4)
  p50                Decimal  @db.Decimal(8, 4)
  p75                Decimal  @db.Decimal(8, 4)
  p90                Decimal  @db.Decimal(8, 4)
  p95                Decimal  @db.Decimal(8, 4)
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz

  @@index([organizationId, testId])
  @@map("continuous_norms")
}

model EquatingCoefficients {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  testId         String   @map("test_id") @db.VarChar(50)
  versionOrigen  String   @map("version_origen") @db.VarChar(50)
  versionDestino String   @map("version_destino") @db.VarChar(50)
  metodo         String   @default("mean_sigma") @db.VarChar(50)
  coeficienteA   Float    @map("coeficiente_a")
  coeficienteB   Float    @map("coeficiente_b")
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz

  @@index([organizationId, testId])
  @@map("equating_coefficients")
}
