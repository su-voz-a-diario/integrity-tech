PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/integrity_production?schema=public

REDIS_HOST=redis-production.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-production-redis-password
REDIS_URL=redis://:replace-with-production-redis-password@redis-production.internal:6379
REDIS_KEY_PREFIX=integrity:production:
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_REQUIRED=true

JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=https://app.integrity.example.com
SHOW_SWAGGER=false
API_BODY_LIMIT=1mb
ENABLE_DEV_AUTH=false
LATE_ANSWER_WINDOW_MS=300000
OTEL_ENABLED=true
OTEL_SERVICE_NAME=integrity-tech-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
LOG_LEVEL=info
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PRIVATE_PATH=
STORAGE_S3_BUCKET=integrity-production-private
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=replace-with-production-access-key
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-production-secret-key
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_FILE_BYTES=2097152
BUILD_DATE=replace-with-build-date
